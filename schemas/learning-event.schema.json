{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextualwisdomlab.github.io/learning/schemas/learning-event.schema.json",
  "title": "CWL Learning Domain Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "tenant_id", "occurred_at", "recorded_at", "provenance_reference"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 3},
    "event_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "tenant_id": {"type": "string", "minLength": 1},
    "subject_reference": {"type": ["string", "null"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": ["string", "null"]},
    "causation_id": {"type": ["string", "null"]},
    "provenance_reference": {"type": "string", "minLength": 1},
    "data": {"type": "object"}
  }
}
