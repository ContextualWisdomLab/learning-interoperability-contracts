{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:task-specification:1.0.0",
  "x-cwl-schema-version": "1.0.0",
  "title": "CWL CEFR Task Specification v1",
  "description": "Metadata-only task contract. Authored task content, official descriptor prose, rubrics, media, and responses stay with their owning systems.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_reference",
    "task_revision_reference",
    "assessment_blueprint_reference",
    "descriptor_source_policy_code",
    "target_language",
    "communication_mode_code",
    "activity_domain_code",
    "use_domain_code",
    "response_mode_code",
    "descriptor_references",
    "target_level_codes",
    "source_content_release_reference",
    "accessibility_profile_reference",
    "rights_reference",
    "linguistic_demand_reference",
    "cognitive_demand_reference",
    "evidence_model_reference",
    "task_content_digest"
  ],
  "properties": {
    "contract_version": {"const": "cwl_cefr_language_assessment/task_specification/v1"},
    "task_reference": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"},
    "task_revision_reference": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"},
    "assessment_blueprint_reference": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"},
    "descriptor_source_policy_code": {"const": "reference_only_no_descriptor_copy"},
    "target_language": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/language_tag"},
    "communication_mode_code": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/communication_mode_code"},
    "activity_domain_code": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/activity_domain_code"},
    "use_domain_code": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/use_domain_code"},
    "response_mode_code": {
      "type": "string",
      "enum": [
        "selected_response",
        "constructed_written",
        "constructed_spoken",
        "interactive_spoken",
        "interactive_written",
        "multimodal",
        "mediated"
      ]
    },
    "descriptor_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"}
    },
    "target_level_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/cefr_level_code"}
    },
    "source_content_release_reference": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"},
    "rubric_revision_reference": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"},
    "accessibility_profile_reference": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"},
    "rights_reference": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"},
    "linguistic_demand_reference": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"},
    "cognitive_demand_reference": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"},
    "interaction_demand_reference": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"},
    "mediation_demand_reference": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"},
    "evidence_model_reference": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/opaque_reference"},
    "task_content_digest": {"$ref": "urn:contextualwisdomlab:learning-interoperability-contracts:cefr-language-assessment:cefr-common:1.0.0#/$defs/sha256_digest"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "response_mode_code": {
            "enum": [
              "constructed_written",
              "constructed_spoken",
              "interactive_spoken",
              "interactive_written",
              "multimodal",
              "mediated"
            ]
          }
        },
        "required": ["response_mode_code"]
      },
      "then": {"required": ["rubric_revision_reference"]}
    },
    {
      "if": {
        "properties": {"communication_mode_code": {"const": "interaction"}},
        "required": ["communication_mode_code"]
      },
      "then": {"required": ["interaction_demand_reference"]}
    },
    {
      "if": {
        "properties": {"communication_mode_code": {"const": "mediation"}},
        "required": ["communication_mode_code"]
      },
      "then": {"required": ["mediation_demand_reference"]}
    }
  ]
}
